-- Dynamic Interface Generator
local function createButton(name, text, layoutOrder)
    local button = Instance.new("TextButton")
    button.Name = name
    button.Size = UDim2.new(0, 210, 0, 40)
    button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    button.Text = text
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextSize = 16
    button.Font = Enum.Font.SourceSans
    button.BorderSizePixel = 0
    button.LayoutOrder = layoutOrder
    button.Parent = ContentFrame
    
    button.MouseEnter:Connect(function() button.BackgroundColor3 = Color3.fromRGB(60, 60, 60) end)
    button.MouseLeave:Connect(function() button.BackgroundColor3 = Color3.fromRGB(45, 45, 45) end)
    
    return button
end

