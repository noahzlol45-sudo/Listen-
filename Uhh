-- 1. F3X Sync API Part Modification
DecalBtn.MouseButton1Click:Connect(function()
    local remote = getF3XRemote()
    if not remote then
        warn("F3X Building Tools configuration absent.")
        return
    end
    
    local targets = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsA("Terrain") then
            table.insert(targets, obj)
        end
    end
    
    if #targets > 0 then
        remote:InvokeServer("CreateTextures", targets, {
            Texture = DECAL_ID,
            Face = Enum.NormalId.Front
        })
    end
end)

-- 2. Client Space Skybox Overrides
SkyboxBtn.MouseButton1Click:Connect(function()
    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("Sky") then obj:Destroy() end
    end
    local sky = Instance.new("Sky")
    sky.SkyboxBk = TEXTURE_ID sky.SkyboxDn = TEXTURE_ID sky.SkyboxFt = TEXTURE_ID
    sky.SkyboxLf = TEXTURE_ID sky.SkyboxRt = TEXTURE_ID sky.SkyboxUp = TEXTURE_ID
    sky.Parent = Lighting
end)

-- 3. Dynamic Player Core Particle Attachment
ParticlesBtn.MouseButton1Click:Connect(function()
    local function addParticlesToPlayer(player)
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = player.Character.HumanoidRootPart
            if not hrp:FindFirstChild("SlasherParticle") then
                local emitter = Instance.new("ParticleEmitter")
                emitter.Name = "SlasherParticle"
                emitter.Texture = TEXTURE_ID
                emitter.Size = NumberSequence.new(2)
                emitter.Speed = NumberRange.new(2)
                emitter.Rate = 1
                emitter.Lifetime = NumberRange.new(3, 5)
                emitter.Parent = hrp
            end
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        addParticlesToPlayer(player)
        player.CharacterAdded:Connect(function()
            task.wait(0.5) addParticlesToPlayer(player)
        end)
    end
    
    Players.PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(function()
            task.wait(0.5) addParticlesToPlayer(player)
        end)
    end)
end)

